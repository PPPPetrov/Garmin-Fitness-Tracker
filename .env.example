# Garmin Connect Personal API key.
# Create at: https://connect.garmin.com/app/settings/personalApiToken
# Shown once only. Treat as a password. Only needed to import; browsing an existing
# database works without it.
GARMIN_PERSONAL_API_KEY=

# --- optional overrides ---

GARMIN_PERSONAL_API_BASE_URL=https://personal.connectapi.garmin.com

# Where the SQLite file, the cached token and FIT scratch space live. All git-ignored.
DATABASE_PATH=./data/garmin.db
# FIT_CACHE_PATH=./data/fit-cache
# TOKEN_CACHE_PATH=./data/token.json

# Reported by /api/status. Day grouping uses Garmin's own local date, not this.
DISPLAY_TIMEZONE=Europe/Athens

# Ports. Change both to run a second checkout alongside the first; Vite proxies
# /api to API_PORT.
# API_PORT=8787
# WEB_PORT=5273
