{
  "name": "garmin-fitness-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private cycling fitness tracker built on the Garmin Connect Personal API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "tsx src/cli.ts sync",
    "sync:fit": "tsx src/cli.ts sync --fit",
    "stats": "tsx src/cli.ts stats",
    "server": "tsx watch src/server.ts",
    "web": "vite",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:server\" \"npm:web\"",
    "build": "vite build",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.158.0",
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
